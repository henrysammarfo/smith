# SMITH forge environment — copy to .env and fill values. Never commit .env.

# Preferred: TensorMux (OpenAI-compatible) — hackathon credits
TENSORMUX_API_KEY=
TENSORMUX_BASE_URL=https://api.tensormux.com/v1

# Fallback / legacy AgentRouter
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_PRIMARY_BASE_URL=https://co.agentrouter.org/v1

# Default model — TensorMux GLM flash for agentic loops
LLM_MODEL=glm-4-7-flash

TAVILY_API_KEY=
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai/v1

SMITH_DB_PATH=data/smith.db
